{
  "id": "1.20.1",
  "type": "release",
  "mainClass": "net.minecraft.client.main.Main",
  "javaVersion": { "component": "java-runtime-gamma", "majorVersion": 17 },
  "assetIndex": {
    "id": "5",
    "sha1": "0000000000000000000000000000000000000000",
    "size": 128,
    "totalSize": 4096,
    "url": "https://piston-meta.mojang.com/v1/packages/5.json"
  },
  "assets": "5",
  "downloads": {
    "client": {
      "sha1": "1111111111111111111111111111111111111111",
      "size": 4096,
      "url": "https://piston-data.mojang.com/v1/objects/client.jar"
    }
  },
  "logging": {
    "client": {
      "argument": "-Dlog4j.configurationFile=${path}",
      "file": {
        "id": "client-1.12.xml",
        "sha1": "2222222222222222222222222222222222222222",
        "size": 128,
        "url": "https://piston-data.mojang.com/v1/objects/log4j.xml"
      },
      "type": "log4j2-xml"
    }
  },
  "libraries": [
    {
      "name": "com.mojang:logging:1.1.1",
      "downloads": {
        "artifact": {
          "path": "com/mojang/logging/1.1.1/logging-1.1.1.jar",
          "sha1": "3333333333333333333333333333333333333333",
          "size": 100,
          "url": "https://libraries.minecraft.net/com/mojang/logging/1.1.1/logging-1.1.1.jar"
        }
      }
    },
    {
      "name": "org.lwjgl:lwjgl:3.3.1",
      "downloads": {
        "artifact": {
          "path": "org/lwjgl/lwjgl/3.3.1/lwjgl-3.3.1.jar",
          "sha1": "4444444444444444444444444444444444444444",
          "size": 100,
          "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.3.1/lwjgl-3.3.1.jar"
        },
        "classifiers": {
          "natives-linux": {
            "path": "org/lwjgl/lwjgl/3.3.1/lwjgl-3.3.1-natives-linux.jar",
            "sha1": "5555555555555555555555555555555555555555",
            "size": 100,
            "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.3.1/lwjgl-3.3.1-natives-linux.jar"
          },
          "natives-windows-64": {
            "path": "org/lwjgl/lwjgl/3.3.1/lwjgl-3.3.1-natives-windows-64.jar",
            "sha1": "6666666666666666666666666666666666666666",
            "size": 100,
            "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.3.1/lwjgl-3.3.1-natives-windows-64.jar"
          }
        }
      },
      "natives": {
        "linux": "natives-linux",
        "windows": "natives-windows-${arch}"
      }
    },
    {
      "name": "com.example:windows-only:1.0",
      "rules": [{ "action": "allow", "os": { "name": "windows" } }],
      "downloads": {
        "artifact": {
          "path": "com/example/windows-only/1.0/windows-only-1.0.jar",
          "sha1": "7777777777777777777777777777777777777777",
          "size": 100,
          "url": "https://libraries.minecraft.net/com/example/windows-only/1.0/windows-only-1.0.jar"
        }
      }
    }
  ],
  "arguments": {
    "game": [
      "--username",
      "${auth_player_name}",
      "--version",
      "${version_name}",
      "--gameDir",
      "${game_directory}",
      "--assetsDir",
      "${assets_root}",
      "--assetIndex",
      "${assets_index_name}",
      "--uuid",
      "${auth_uuid}",
      "--accessToken",
      "${auth_access_token}",
      "--userType",
      "${user_type}",
      "--versionType",
      "${version_type}",
      {
        "rules": [{ "action": "allow", "features": { "has_custom_resolution": true } }],
        "value": ["--width", "${resolution_width}", "--height", "${resolution_height}"]
      }
    ],
    "jvm": [
      {
        "rules": [{ "action": "allow", "os": { "name": "windows" } }],
        "value": "-Dos.name=Windows 10"
      },
      {
        "rules": [{ "action": "allow", "os": { "name": "osx" } }],
        "value": "-XstartOnFirstThread"
      },
      "-Djava.library.path=${natives_directory}",
      "-cp",
      "${classpath}"
    ]
  }
}
